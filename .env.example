# CLAF — Closed-Loop Agent Framework
# Copy this file to .env and fill in real values.
# .env is git-ignored. NEVER commit the real .env.

# ── Routing mode ─────────────────────────────────────────────────────────────
# local   — Ollama only, no cloud peers
# hybrid  — Ollama first, cloud escalation on hard tasks  (default)
# cloud   — cloud peer pool only, Ollama bypassed
CLAF_MODE=hybrid

# ── Local Ollama ──────────────────────────────────────────────────────────────
CLAF_LOCAL_MODEL=qwen2.5-coder:64k
CLAF_SPEED_MODEL=qwen2.5-coder:fast
CLAF_OLLAMA_URL=http://localhost:11434/api/chat
CLAF_OLLAMA_CTX=8192
CLAF_LOCAL_MAX_PREDICT=2048
CLAF_LOCAL_MAX_MSGS=5
CLAF_LOCAL_CODE_TOOLS=1
CLAF_LOCAL_AUTO_RETRY=3
CLAF_LOCAL_MSG_CONTENT_MAX=4000
CLAF_LOCAL_SYS_MAX_CHARS=8000
CLAF_LOCAL_MAX_TOOLS=10
CLAF_LOCAL_CONSTRAINED=1

# ── Server ────────────────────────────────────────────────────────────────────
CLAF_PORT=8000
CLAF_LOG_FILE=~/projects/claf/orchestrator.log

# ── Cloud escalation (all optional — only read when MODE=hybrid or cloud) ─────
CLAF_PREFERRED_CLOUD=anthropic
CLAF_CLOUD_SYS_MAX_CHARS=12000
CLAF_CLOUD_MAX_MSGS=20
CLAF_CLOUD_MSG_CONTENT_MAX=8000

# ── Thinking / planning ───────────────────────────────────────────────────────
CLAF_THINK_LEVEL=none
CLAF_MAX_LOOP_TURNS=0
CLAF_MAX_REPLAN_EPOCHS=3

# ── Cloud API keys (only needed in hybrid/cloud mode) ─────────────────────────
# These are read from ~/.master_ai_keys at runtime — set them there, not here.
# Stub entries below for documentation only.
# ANTHROPIC_CONSOLE_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# CEREBRAS_API_KEY=csk-...
# FIREWORKS_API_KEY=fw_...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# ── Tool keys ─────────────────────────────────────────────────────────────────
# FIRECRAWL_API_KEY=fc-...
# SERPER_API_KEY=...

# ── Voice bridge (optional) ───────────────────────────────────────────────────
CLAF_URL=http://localhost:8000
VOICE_BRIDGE_API_KEY=
VOICE_BRIDGE_GROQ_TIMEOUT=30
VOICE_BRIDGE_CLAF_TIMEOUT=120
VOICE_BRIDGE_MAX_TRANSCRIPT_CHARS=2000
VOICE_BRIDGE_LLM_MODEL=llama-3.3-70b-versatile
