# Gaming PC profile — GTX 1660 Ti / 6 GB VRAM / qwen3.5:9b
# Usage: source ~/projects/claf/profiles/gaming-pc.env
#        systemctl --user restart claf

CLAF_LOCAL_MODEL=qwen3.5:9b
CLAF_OLLAMA_CTX=4096
CLAF_LOCAL_MAX_TOOLS=10
CLAF_LOCAL_MAX_PREDICT=1024
CLAF_LOCAL_MSG_CONTENT_MAX=4000
CLAF_LOCAL_SYS_MAX_CHARS=8000
CLAF_LOCAL_MAX_MSGS=6
CLAF_THINK_LEVEL=none
CLAF_MAX_LOOP_TURNS=20
CLAF_MAX_REPLAN_EPOCHS=3
# ANTHROPIC_API_KEY injected from keychain at install time
