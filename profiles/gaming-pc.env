# Gaming PC profile — GTX 1660 Ti / 6 GB VRAM / qwen3.5:9b
#
# Usage:
#   source ~/projects/claf/profiles/gaming-pc.env
#   systemctl --user restart claf
#
# Or copy these lines into ~/projects/claf/.env so they load automatically.

CLAF_LOCAL_MODEL=qwen3.5:9b

# KV cache at 4096 CTX fits in the ~500 MB VRAM headroom left after qwen3.5:9b
# loads (~5.5 GB). At 8192 CTX the KV cache spills to CPU RAM → slow prompt eval.
CLAF_OLLAMA_CTX=4096

# Toolbox model: send 6 tools from the matching group (~1000 tokens).
# NEVER set to 0 — that strips all tools and breaks local agent work.
# Group selection: browser signals → sensei tools; file/code → Read/Bash/Edit; etc.
CLAF_LOCAL_MAX_TOOLS=6

# Output token cap. Default 512 is too tight for code responses.
CLAF_LOCAL_MAX_PREDICT=1024

# Per-message char cap — keeps message history inside the CTX budget.
CLAF_LOCAL_MSG_CONTENT_MAX=800

# Number of messages to keep (after trimming).
CLAF_LOCAL_MAX_MSGS=6

# Thinking token budget for planning turns (tool calls always use think=false).
# Values: light=512  medium=1024  heavy=2048  extra=4096
CLAF_THINK_LEVEL=light
