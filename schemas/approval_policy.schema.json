{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "secretary.autonomous.v1/approval_policy",
  "title": "Secretary Approval Policy",
  "type": "object",
  "required": ["auto_approved", "requires_approval"],
  "properties": {
    "auto_approved": {
      "type": "array",
      "description": "Tools that run without operator confirmation",
      "items": { "type": "string" },
      "examples": ["bash", "read_file", "write_file", "browser_read", "web_search"]
    },
    "requires_approval": {
      "type": "array",
      "description": "Tools that must pause for operator approval",
      "items": { "type": "string" },
      "examples": ["browser_fill", "browser_click"]
    },
    "always_blocked": {
      "type": "array",
      "description": "Tools never permitted in autonomous mode",
      "items": { "type": "string" }
    }
  }
}
